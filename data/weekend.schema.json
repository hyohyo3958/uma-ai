{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UMA AI weekend race data",
  "type": "object",
  "required": [
    "generated_at",
    "source_status",
    "races"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_status": {
      "type": "string",
      "enum": [
        "not_connected",
        "partial",
        "verified"
      ]
    },
    "races": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "venue",
          "race_no",
          "data_status"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "venue": {
            "type": "string"
          },
          "race_no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "race_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "grade": {
            "type": [
              "string",
              "null"
            ]
          },
          "surface": {
            "type": [
              "string",
              "null"
            ]
          },
          "distance_m": {
            "type": [
              "integer",
              "null"
            ]
          },
          "runners": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "horse_no": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "horse_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "jockey": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "win_odds": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "popularity": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          },
          "data_status": {
            "type": "string",
            "enum": [
              "scheduled_only",
              "entries_pending",
              "entries_verified",
              "partial",
              "verified"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  }
}
